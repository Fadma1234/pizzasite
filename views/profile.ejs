<!doctype html>
<html>

<head>
  <title>Recipe Share Site</title>
  <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <div class="container">
    <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    <div class="page-header text-center">
      <h1>Recipe Hub</h1>
    </div>

    <div class="row">

      <div class="col-sm-6">
        <h3>Shared Recipes</h3>
        <ul class="recipes-list">
          <% if (typeof recipes !=='undefined' && recipes.length> 0) { %>
            <% for(var i=0; i<recipes.length; i++) {%>
              <li class="recipe-item">
                <h4>
                  <%= recipes[i].type %>
                </h4>
                <img src="<%= recipes[i].image %>" alt="<%= recipes[i].type %>" style="max-width: 100%; height: auto;">
                <p><strong>Ingredients:</strong>
                  <%= recipes[i].ingredients %>
                </p>
                <p><strong>Steps:</strong>
                  <%= recipes[i].steps %>
                </p>

                <button class="btn btn-sm btn-info edit-recipe" data-id="<%= recipes[i]._id %>">Edit</button>
                <button class="btn btn-sm btn-danger delete-recipe" data-id="<%= recipes[i]._id %>">Delete</button>

              </li>
              <% } %>
                <% } else { %>
                  <p>No recipes shared yet.</p>
                  <% } %>
        </ul>

        <h2>Share a Recipe</h2>
        <% if (user.local.email) { %>
          <form action="/recipes" method="POST">
            <input type="text" placeholder="Recipe Title" name="title" required class="form-control mb-2">
            <input type="text" placeholder="Image URL Link" name="imageUrl" required class="form-control mb-2">
            <textarea placeholder="Ingredients (comma separated)" name="ingredients" required
              class="form-control mb-2"></textarea>
            <textarea placeholder="Steps" name="steps" required class="form-control mb-2"></textarea>
            <button type="submit" class="btn btn-primary">Submit Recipe</button>
          </form>
          <% } %>
      </div>

      <div class="col-sm-6">
      </div>

    </div>
  </div>


  <script src="main.js"></script>

</body>

</html>